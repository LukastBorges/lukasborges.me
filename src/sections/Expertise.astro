---
import SectionHeader from '@/components/SectionHeader.astro';
import { skillGroups } from '@/data/skills';
---

<section class="section expertise" id="expertise" aria-labelledby="expertise-title">
  <div class="container">
    <SectionHeader index={3} label="Expertise" id="expertise-title" title="What I bring to a team.">
      <p>
        Grouped by the problems they solve.{' '}
        <span class="expertise__legend">
          <span class="expertise__core-dot" aria-hidden="true"></span>{' '}marks a core strength.
        </span>
      </p>
    </SectionHeader>

    <ul role="list" class="expertise__grid" data-spotlight>
      {skillGroups.map((group, i) => (
        <li class="card" data-reveal style={`--i: ${i % 3}`}>
          <h3 class="card__title">{group.title}</h3>
          <p class="card__description">{group.description}</p>
          <ul role="list" class="card__skills">
            {group.skills.map((skill) => (
              <li class:list={['skill', { 'skill--core': skill.core }]}>
                {skill.core && <span class="expertise__core-dot" aria-hidden="true" />}
                {skill.name}
                {skill.core && <span class="visually-hidden"> (core strength)</span>}
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  // Pointer-following spotlight on cards (fine pointers only).
  const grid = document.querySelector<HTMLElement>('[data-spotlight]');
  if (grid && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    grid.addEventListener(
      'pointermove',
      (event) => {
        const card = (event.target as HTMLElement).closest<HTMLElement>('.card');
        if (!card) return;
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${event.clientX - rect.left}px`);
        card.style.setProperty('--my', `${event.clientY - rect.top}px`);
      },
      { passive: true },
    );
  }
</script>

<style>
  .expertise__grid {
    display: grid;
    gap: var(--space-4);
  }

  .card {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    overflow: hidden;
    transition:
      border-color var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      28rem circle at var(--mx, 50%) var(--my, -20%),
      var(--glow),
      transparent 45%
    );
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-out);
    pointer-events: none;
  }

  .card:hover {
    border-color: var(--border-strong);
  }

  .card:hover::before {
    opacity: 1;
  }

  .card__title {
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-snug);
  }

  .card__description {
    color: var(--text-muted);
    font-size: var(--text-sm);
    max-width: 30rem;
  }

  .card__skills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .skill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.3125rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: 1.4;
  }

  .skill--core {
    border-color: var(--border-strong);
    color: var(--text);
  }

  .expertise__core-dot {
    display: inline-block;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--accent);
    vertical-align: middle;
  }

  .expertise__legend {
    white-space: nowrap;
  }

  @media (min-width: 48rem) {
    .expertise__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 72rem) {
    .expertise__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
