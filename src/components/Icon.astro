---
import { FILL, type IconName, STROKE } from '@/lib/icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 18, class: className } = Astro.props;
const isFill = name in FILL;
const body = isFill ? FILL[name as keyof typeof FILL] : STROKE[name as keyof typeof STROKE];
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={isFill ? 'currentColor' : 'none'}
  stroke={isFill ? 'none' : 'currentColor'}
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={body}
/>

<style>
  .icon {
    flex-shrink: 0;
  }
</style>
