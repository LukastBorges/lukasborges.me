---
/**
 * Abstract, code-drawn illustrations for case studies (no product screenshots are public).
 * Each motif hints at the engineering story: staged migration, component system, data, pipeline.
 */
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<div class="visual" aria-hidden="true">
  <svg viewBox="0 0 400 260" preserveAspectRatio="xMidYMid meet" fill="none" aria-hidden="true">
    <defs>
      <pattern id={`grid-${id}`} width="20" height="20" patternUnits="userSpaceOnUse">
        <path d="M20 0H0V20" class="v-grid" />
      </pattern>
    </defs>
    <rect width="400" height="260" fill={`url(#grid-${id})`} />

    {id === 'hostfully-guidebooks' && (
      <g>
        {/* Legacy app frame */}
        <rect x="44" y="52" width="190" height="150" rx="10" class="v-surface v-dim" />
        <rect x="44" y="52" width="190" height="22" rx="10" class="v-line" />
        <rect x="60" y="92" width="90" height="8" rx="4" class="v-ink-dim" />
        <rect x="60" y="110" width="140" height="8" rx="4" class="v-ink-dim" />
        <rect x="60" y="128" width="120" height="8" rx="4" class="v-ink-dim" />
        {/* New app frame, overlapping: the staged replacement */}
        <rect x="166" y="72" width="190" height="150" rx="10" class="v-surface v-front" />
        <rect x="166" y="72" width="190" height="22" rx="10" class="v-line" />
        <circle cx="180" cy="83" r="3" class="v-accent-fill" />
        <rect x="182" y="110" width="70" height="44" rx="6" class="v-accent-soft" />
        <rect x="262" y="110" width="78" height="44" rx="6" class="v-line" />
        <rect x="182" y="166" width="158" height="8" rx="4" class="v-ink" />
        <rect x="182" y="184" width="110" height="8" rx="4" class="v-ink-dim" />
        {/* Bridge between frames */}
        <path d="M234 128h-68" class="v-accent-stroke v-dash" />
      </g>
    )}

    {id === 'hostfully-ai-workflow' && (
      <g>
        {/* Plan document feeding the agent */}
        <rect x="40" y="64" width="96" height="132" rx="10" class="v-surface" />
        {[0, 1, 2, 3, 4].map((i) => (
          <g>
            <path
              d={`M54 ${92 + i * 20}l4 4 7-8`}
              class={i < 3 ? 'v-accent-stroke' : 'v-ink-stroke'}
            />
            <rect
              x="72"
              y={`${89 + i * 20}`}
              width={i % 2 ? 40 : 52}
              height="6"
              rx="3"
              class="v-ink-dim"
            />
          </g>
        ))}
        <path d="M136 130h52" class="v-ink-stroke v-dash" />
        {/* Agent */}
        <circle cx="220" cy="130" r="32" class="v-accent-soft" />
        <circle cx="220" cy="130" r="8" class="v-accent-fill" />
        {/* MCP context sources */}
        {[
          ['figma', 62],
          ['jira', 130],
          ['mui', 198],
        ].map(([label, y]) => (
          <g>
            <path d={`M252 130 C 276 130, 280 ${y}, 300 ${y}`} class="v-accent-stroke v-dash" />
            <rect x="300" y={Number(y) - 16} width="72" height="32" rx="16" class="v-surface" />
            <text x="336" y={Number(y) + 4} text-anchor="middle" class="v-label">
              {label}
            </text>
          </g>
        ))}
      </g>
    )}

    {id === 'loadsmart-design-system' && (
      <g>
        {[0, 1, 2, 3].map((col) =>
          [0, 1, 2].map((row) => (
            <rect
              x={56 + col * 76}
              y={44 + row * 60}
              width="64"
              height="48"
              rx="8"
              class={(col + row) % 4 === 1 ? 'v-accent-soft' : 'v-surface'}
            />
          )),
        )}
        <rect x="68" y="60" width="40" height="8" rx="4" class="v-ink" />
        <rect x="144" y="120" width="40" height="16" rx="8" class="v-accent-fill" />
        <circle cx="248" cy="68" r="10" class="v-line" />
        <rect x="296" y="122" width="36" height="12" rx="6" class="v-line" />
        <path d="M82 188h32M98 172v32" class="v-ink-stroke" />
        <rect x="220" y="176" width="44" height="24" rx="4" class="v-line" />
      </g>
    )}

    {id === 'invesco-portfolio-platform' && (
      <g>
        <rect x="40" y="40" width="320" height="180" rx="10" class="v-surface" />
        <path d="M56 180H344" class="v-line-stroke" />
        <path d="M56 140H344M56 100H344" class="v-line-stroke v-dash" />
        <path
          d="M56 172 C 96 166, 112 150, 144 152 S 196 120, 228 126 S 288 86, 344 70"
          class="v-accent-stroke"
        />
        <path
          d="M56 172 C 96 166, 112 150, 144 152 S 196 120, 228 126 S 288 86, 344 70 V180 H56 Z"
          class="v-accent-area"
        />
        <path
          d="M56 176 C 110 172, 160 164, 220 156 S 300 140, 344 128"
          class="v-ink-stroke v-dash"
        />
        {[0, 1, 2, 3, 4, 5].map((i) => (
          <rect x={64 + i * 46} y="196" width="30" height="6" rx="3" class="v-ink-dim" />
        ))}
        <circle cx="344" cy="70" r="4" class="v-accent-fill" />
      </g>
    )}

    {id === 'google-internal-tooling' && (
      <g>
        {[
          [70, 130],
          [150, 80],
          [150, 180],
          [240, 130],
          [330, 130],
        ].map(([x, y], i) => (
          <rect
            x={(x ?? 0) - 26}
            y={(y ?? 0) - 18}
            width="52"
            height="36"
            rx="8"
            class={i === 3 ? 'v-accent-soft' : 'v-surface'}
          />
        ))}
        <path
          d="M96 124 124 88M96 136l28 38M176 80l38 44M176 180l38-44M266 130h38"
          class="v-ink-stroke"
        />
        <circle cx="240" cy="130" r="4" class="v-accent-fill" />
      </g>
    )}
  </svg>
</div>

<style>
  .visual {
    position: relative;
    aspect-ratio: 400 / 260;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: radial-gradient(circle at 80% 0%, var(--glow), transparent 60%), var(--bg-elevated);
    overflow: hidden;
  }

  .visual svg {
    width: 100%;
    height: 100%;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  :global(.project:hover) .visual svg {
    transform: scale(1.03);
  }

  .visual :global(.v-grid) {
    stroke: var(--border);
    stroke-width: 1;
    fill: none;
  }

  .visual :global(.v-surface) {
    fill: var(--surface-hover);
    stroke: var(--border-strong);
  }

  .visual :global(.v-front) {
    fill: var(--bg-elevated);
  }

  .visual :global(.v-dim) {
    opacity: 0.6;
  }

  .visual :global(.v-line) {
    fill: none;
    stroke: var(--border-strong);
  }

  .visual :global(.v-line-stroke) {
    stroke: var(--border-strong);
  }

  .visual :global(.v-ink) {
    fill: var(--text-subtle);
  }

  .visual :global(.v-ink-dim) {
    fill: var(--border-strong);
  }

  .visual :global(.v-ink-stroke) {
    stroke: var(--text-subtle);
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .visual :global(.v-accent-fill) {
    fill: var(--accent);
  }

  .visual :global(.v-accent-soft) {
    fill: var(--accent-muted);
    stroke: var(--accent);
    stroke-opacity: 0.5;
  }

  .visual :global(.v-accent-stroke) {
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linecap: round;
    fill: none;
  }

  .visual :global(.v-accent-area) {
    fill: var(--accent-muted);
  }

  .visual :global(.v-label) {
    fill: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .visual :global(.v-dash) {
    stroke-dasharray: 4 6;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.project:hover) .visual :global(.v-dash) {
      animation: dash 1.2s linear infinite;
    }
  }

  @keyframes dash {
    to {
      stroke-dashoffset: -20;
    }
  }
</style>
